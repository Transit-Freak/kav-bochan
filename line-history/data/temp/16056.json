nקו 96 כיוון 2\nלכיוון שבטי ישראל – מסלול חלופי: שמואל הנביא- חטיבת הראל- ארץ חפץ- שמעון הצדיק- זקס והמשך מסלול כרגיל.\n \n\nעדכון 14:40 בעקבות הנחיית משטרה קווי השירות מווסטים מצירי יחזקאל, כיכר השבת ובר אילן\n\n\n\nקווים מושפעים 1.3.25.36.45.51.52.55.56.59.64.65.67.68.69.70.89.96.568.753.794\n\n","rm":[["3008","יחזקאל/כיכר השבת "],["4075","שמגר/אוהל יהושע"],["3634","שמואל הנביא/גבעת משה"],["155","אוהל יהושע/זית רענן"],["1150","יחזקאל/רבנו גרשום"],["1171","יחזקאל/רבנו גרשום"],["4037","יחזקאל/הושע"],["9949","אהל יהושע/מנחת יצחק"],["4116","שמגר/ירמיהו"],["1375","שדרות לוי אשכול/משמר הגבול"],["1784","שדרות לוי אשכול/קרל נטר"],["1783","שד' אשכול/ששת הימים"],["1352","שד' אשכול/משמר הגבול"],["1202","שמואל הנביא/פישל"],["1731","שדרות לוי אשכול/קרל נטר"],["666","שמואל הנביא/בר אילן"],["3607","ככר השבת/שטראוס"],["3352","שטראוס/פראג"],["4015","שמגר/תורה מציון"],["1799","שד' אשכול/ברלב"],["541","שמואל הנביא/פישל"],["78","שרי ישראל/יפו"],["5886","ככר השבת/ישעיהו"],["5985","עלי הכהן/גרוסברג"],["3820","עלי הכהן/בר אילן"],["1592","ירמיהו/שמגר"],["1351","חטיבת הראל/ארץ חפץ"],["5060","בר אילן/רבנו גרשום"],["3818","שטראוס/פראג"],["3858","ככר השבת/שטראוס"],["1318","מלכי ישראל/בן מתתיהו"],["6012","מלכי ישראל/הרב פלדמן"],["4115","ככר השבת/מלכי ישראל"],["4133","שמגר/ירמיהו"],["1344","פיתוחי חותם"],["111","יעקובזון/עזרת תורה"],["84","מלכי ישראל/הטורים"],["112","יעקובזון/עזרת תורה"],["1917","מלכי ישראל/תחכמוני"],["3632","מלכי ישראל/בן מתתיהו"],["3633","ככר השבת/מלכי ישראל"],["3629","רב שפע/שמגר"],["110","עזרת תורה/דורש טוב"],["108","עזרת תורה/עלי הכהן"],["1317","ישעיהו/דוד ילין"],["109","עזרת תורה/דורש טוב"],["2811","גבעת משה/עלי הכהן"],["213","זקס"],["214","שמואל הנביא/יקים"],["215","שמואל הנביא/תדהר"],["1933","מלכי ישראל/שדרות שרי ישראל"],["9841","צפניה/יחזקאל"],["9840","צפניה/נחמיה"],["2831","האדמורים ליינער"],["2830","האדמורים ליינער"],["210","שמואל הנביא/תדהר"],["211","שמואל הנביא/יקים"],["1332","נחמיה/צפניה"],["3677","עזרא"],["1335","שמעון הצדיק/ארץ חפץ"],["3242","ברנדייס"]],"add":[