        "e4037c010a5e822bdea4": {
          "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
          "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך",
          "sections": [
            {
              "title": "שלבי ההפעלה",
              "text": "בגרסת המסמך: שלב א׳ בתוך 12 חודשים מהודעת הזכייה, ושלב ב׳ בתוך 18 חודשים. היישום כפוף לתשתיות, לתנאי המכרז ולאישורי הוועדה.",
              "unitIndices": [
                6,
                7
              ],
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=7",
                  "locator": "עמוד PDF 7",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 6
                },
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=8",
                  "locator": "עמוד PDF 8",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 7
                }
              ]
            },
            {
              "title": "משך ההתקשרות",
              "text": "תקופת הבסיס כוללת עשר שנות הפעלה ותקופת הכנות: 132 חודשים לשלב א׳ ו־138 חודשים לשלב ב׳. איחור עשוי לקצר את תקופת ההפעלה ולהוביל לפיצויים, בהתאם לתנאים. ההבהרות המאוחרות עדיין בבדיקה.",
              "unitIndices": [
                7
              ],
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=8",
                  "locator": "עמוד PDF 8",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 7
                }
              ]
            },
            {
              "title": "עלות ההפעלה",
              "text": "במסמך הבסיס נקבעה עלות הפעלה שנתית של 123.6 מיליון ש״ח לפני מע״מ, בתוספת רכיב ההצעה הכספית ובכפוף למנגנוני ההתחשבנות. זה אינו מחיר זכייה. ההצעה חייבת לעמוד לפחות ברמת השירות שנדרשה. טרם הושלמה בדיקת ההבהרות המאוחרות.",
              "unitIndices": [
                18,
                19
              ],
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=19",
                  "locator": "עמוד PDF 19",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 18
                },
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=20",
                  "locator": "עמוד PDF 20",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 19
                }
              ]
            },
            {
              "title": "נהגים והכשרה",
              "text": "הנהגים יועסקו ישירות בידי המפעיל. המציע מתחייב לשכר יסוד ולשיעור מתמריץ איסוף הנוסעים שיועבר לנהגים. נקבע מענק הכשרה של 30 אלף ש״ח לנהג, עד 45 נהגים, בכפוף בין היתר להכשרת לפחות 25 נהגים בתוך 18 חודשים ולתקופת העסקה נדרשת. נוסח מגבלת 36 החודשים מחייב בדיקה נוספת מול ההבהרות.",
              "unitIndices": [
                20,
                21
              ],
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=21",
                  "locator": "עמוד PDF 21",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 20
                },
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=22",
                  "locator": "עמוד PDF 22",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 21
                }
              ]
            },
            {
              "title": "אישורים נלווים",
              "text": "נדרשים אישורי מס וניהול ספרים, תצהירים והתחייבויות בנושאי העסקת עובדים, תנאים סוציאליים, תוכנות מקור ודרישות אוויר נקי. תנאי הסף המלאים מופיעים גם בסעיפים הקודמים.",
              "unitIndices": [
                18
              ],
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=19",
                  "locator": "עמוד PDF 19",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 18
                }
              ]
            }
          ],
