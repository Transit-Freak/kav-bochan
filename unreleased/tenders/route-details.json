          "text": "המסלול יסתיים בשחר ויבוטל הקטע לשדרות. בדרך לאשקלון יינתן שירות לנוהר, ניר ח״ן ועוצם, ותתווסף כניסה לרכבת אשקלון.",
          "relatedNumbers": [],
          "sources": [
            {
              "url": "https://www.gov.il/BlobFolder/guide/agreements_for_operating_service_lines_in_public_transportation/he/TenderNorthernNegev.pdf#page=85",
              "locator": "עמוד PDF 85 · עמוד מודפס 79 · סעיף 34.1.2",
              "page": 85,
              "printedPage": 79,
              "evidenceType": "user_screenshot",
              "evidenceSha256": "38b4e51de6bf7293e18c5a0bcea2b40e0971d8a64ef35f4c3f7be16db0c2fb94"
            }
