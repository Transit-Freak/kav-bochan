                },
                {
                  "number": "38",
                  "catalogNumber": "10038",
                  "area": "חיפה"
                },
                {
                  "number": "40",
                  "catalogNumber": "10040",
                  "area": "חיפה"
                },
                {
                  "number": "42",
                  "catalogNumber": "10042",
                  "area": "חיפה"
                },
                {
                  "number": "76",
                  "catalogNumber": "10076",
                  "area": "חיפה"
                }
              ],
              "text": "מתוכננים שינויים גם במסלול וגם בתדירות; את התוואי והתדירות המדויקים יש להשלים ממפרט הקו.",
              "unitIndices": [
                70
              ],
              "title": "פרטי המסלול והשירות",
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=71",
                  "locator": "עמוד PDF 71",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 70
                }
              ]
            },
            {
              "targets": [
                {
                  "number": "6",
                  "catalogNumber": "10006",
                  "area": "חיפה"
                },
                {
                  "number": "9",
                  "catalogNumber": "11009",
                  "area": "חיפה"
                }
              ],
              "text": "בנוסף לשירות הסדיר, חלופה ת׳ של הקו מוגדרת במכרז כחלופת תלמידים.",
              "unitIndices": [
                71
              ],
              "title": "חלופת תלמידים",
