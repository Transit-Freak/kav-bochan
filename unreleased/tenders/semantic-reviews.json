                },
                {
                  "number": "16",
                  "catalogNumber": "10016",
                  "area": "חיפה"
                }
              ],
              "text": "מתוכנן שינוי בתדירות בלבד. שיעור השינוי וזמני הנסיעות דורשים קריאה במפרט הקו.",
              "unitIndices": [
                70
              ],
              "title": "פרטי המסלול והשירות",
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=71",
                  "locator": "עמוד PDF 71",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 70
                }
              ]
            },
            {
              "targets": [
                {
                  "number": "10",
                  "catalogNumber": "10010",
                  "area": "חיפה"
                },
                {
                  "number": "41",
                  "catalogNumber": "25041",
                  "area": "חיפה"
                }
              ],
              "text": "מתוכנן שינוי במסלול בלבד. הפסקה אינה מפרטת את הרחובות שהשתנו.",
              "unitIndices": [
                70
              ],
              "title": "פרטי המסלול והשירות",
              "sources": [
                {
                  "url": "https://mr.gov.il/ilgstorefront/he/p/attachment/005056BF65EB1FD0B89C5F0C1C0EA156/מסמכי הליך#page=71",
                  "locator": "עמוד PDF 71",
                  "sha256": "1d42aa65dd2b57d8e39777c46068338109d7a8dcad08df811a5ff1f5e92dd1bb",
                  "unit": 70
                }
              ]
            },
            {
              "targets": [
                {
                  "number": "9",
                  "catalogNumber": "11009",
                  "area": "חיפה"
                },
                {
                  "number": "17",
                  "catalogNumber": "10017",
                  "area": "חיפה"
                },
                {
                  "number": "18",
                  "catalogNumber": "10018",
                  "area": "חיפה"
                },
                {
                  "number": "20",
                  "catalogNumber": "10020",
                  "area": "חיפה"
                },
                {
                  "number": "24",
